/**
 * @file 0-CMS — Environment Variables
 * Copy this file to `.env` and adjust values for your environment.
 * Every variable is validated at startup; the app refuses to boot if any is
 * missing or malformed. See `config/index.js` for the schema.
 *
 * ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite file path. Relative paths are resolved from the project root, never
# from the current working directory.
DATABASE_URL=./db.sqlite

# ─── Uploads ────────────────────────────────────────────────────────────────
# Storage root. Served read-only at /storage. Blobs land in files/YYYY/MM/,
# in-flight uploads in temp/ (never served).
FILES_DIR=./storage
UPLOAD_MAX_MB=10
# Comma-separated allow-list. Changing this takes effect immediately — the
# mimetype column is plain TEXT, so no migration is needed.
FILE_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,image/svg+xml,application/pdf,text/plain,text/markdown,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ─── Interface ──────────────────────────────────────────────────────────────
# Default rows per list page (capped at 100).
PAGE_SIZE=10
# Theme applied before the visitor has chosen one. Dark is the product default.
DEFAULT_THEME=dark
# Comma-separated list of `types.slug` values whose posts.content is rendered
# as Markdown. Every other type is shown as escaped plain text.
MARKDOWN_TYPES=article

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# "pretty" is human-readable and requires the pino-pretty dev dependency.
# "json" writes one JSON object per line and needs nothing extra.
LOG_FORMAT=pretty